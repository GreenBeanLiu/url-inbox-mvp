DATABASE_URL="postgresql://postgres:postgres@localhost:5432/url_inbox_mvp?schema=public"

# Required only if you want x.com / twitter.com imports to resolve via TikHub.
TIKHUB_API_TOKEN=
TIKHUB_API_BASE_URL=https://api.tikhub.io

# Required for AI analysis via Vercel AI SDK.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint, e.g. OpenRouter / custom gateway.
OPENAI_BASE_URL=
# Optional model override.
AI_MODEL=gpt-5.4-mini
# Optional reasoning effort for supported OpenAI-compatible providers.
AI_REASONING_EFFORT=high
# Optional output verbosity for supported OpenAI-compatible providers.
AI_TEXT_VERBOSITY=high
