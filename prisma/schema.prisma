generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id            String   @id
  sourceType    String
  sourceUrl     String
  canonicalUrl  String
  externalId    String?
  title         String?
  summary       String?
  contentText   String?
  authorName    String?
  authorHandle  String?
  siteName      String?
  coverImageUrl String?
  publishedAt   DateTime?
  note          String?
  status        String
  fetchStatus   String
  fetchError    String?
  rawPayload    Json?
  meta          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sourceType, externalId])
  @@index([sourceType, canonicalUrl])
}
